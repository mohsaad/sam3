# SAM 3 Embedding Extraction Dockerfile
# This container provides an environment for extracting embeddings from SAM 3 model

# Use NVIDIA CUDA base image with Ubuntu
FROM nvidia/cuda:12.6.0-cudnn-runtime-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3-pip \
    git \
    wget \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set python3.12 as default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.6 support
RUN pip3 install torch==2.7.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126

# Set working directory
WORKDIR /workspace

# Copy the SAM3 repository
COPY . /workspace/sam3/

# Install SAM3 package
RUN cd /workspace/sam3 && \
    pip3 install -e .

# Copy the embedding extraction script
COPY extract_embeddings.py /workspace/extract_embeddings.py

# Make the script executable
RUN chmod +x /workspace/extract_embeddings.py

# Create directories for input/output
RUN mkdir -p /workspace/input /workspace/output

# Set environment variables for the script
ENV HF_HOME=/workspace/.cache/huggingface
ENV TORCH_HOME=/workspace/.cache/torch

# Create cache directories
RUN mkdir -p /workspace/.cache/huggingface /workspace/.cache/torch

# Health check - verify CUDA is available
RUN python3 -c "import torch; assert torch.cuda.is_available(), 'CUDA not available'"

# Default entrypoint
ENTRYPOINT ["python3", "/workspace/extract_embeddings.py"]

# Default command shows help
CMD ["--help"]
