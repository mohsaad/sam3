# SAM 3 SageMaker Inference Dockerfile
# This container provides a SageMaker-compatible inference endpoint for SAM 3

# Use NVIDIA CUDA base image with Ubuntu
FROM nvidia/cuda:12.6.0-cudnn-runtime-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3-pip \
    git \
    wget \
    nginx \
    ca-certificates \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set python3.12 as default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.6 support
RUN pip3 install torch==2.7.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126

# Install additional dependencies for SageMaker
RUN pip3 install \
    flask \
    gunicorn \
    boto3 \
    numpy \
    pillow \
    tqdm \
    gevent

# Set working directory
WORKDIR /opt/ml

# Copy the SAM3 repository
COPY . /opt/ml/code/sam3/

# Install SAM3 package
RUN cd /opt/ml/code/sam3 && \
    pip3 install -e .

# Copy inference scripts
COPY inference_with_embeddings.py /opt/ml/code/inference_with_embeddings.py
COPY sagemaker/serve /opt/ml/code/serve
COPY sagemaker/nginx.conf /opt/ml/code/nginx.conf
COPY sagemaker/wsgi.py /opt/ml/code/wsgi.py

# Make serve executable
RUN chmod +x /opt/ml/code/serve

# Set environment variables
ENV PYTHONPATH="/opt/ml/code:${PYTHONPATH}"
ENV PATH="/opt/ml/code:${PATH}"
ENV HF_HOME=/opt/ml/model/.cache/huggingface
ENV TORCH_HOME=/opt/ml/model/.cache/torch

# SageMaker uses /opt/ml for model artifacts and processing
# /opt/ml/model - model artifacts
# /opt/ml/input/data - input data
# /opt/ml/output - output data
RUN mkdir -p /opt/ml/model /opt/ml/input/data /opt/ml/output

# Expose port for SageMaker
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s \
    CMD curl -f http://localhost:8080/ping || exit 1

# Set working directory to code
WORKDIR /opt/ml/code

# Default entrypoint
ENTRYPOINT ["/opt/ml/code/serve"]
