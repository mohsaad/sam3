"""
SageMaker Inference Server Entry Point

This script starts the Flask application for serving SAM 3 inference requests.
It's called by SageMaker when the endpoint is created.
"""

import multiprocessing
import os
import signal
import subprocess
import sys


def sigterm_handler(nginx_pid, gunicorn_pid):
    """Handle SIGTERM signal for graceful shutdown."""
    try:
        os.kill(nginx_pid, signal.SIGQUIT)
    except OSError:
        pass
    try:
        os.kill(gunicorn_pid, signal.SIGTERM)
    except OSError:
        pass
    sys.exit(0)


def start_server():
    """Start the inference server with nginx and gunicorn."""
    print("Starting SageMaker inference server...")

    # Number of workers
    # Use (2 * num_cores) + 1 as recommended, but cap at 4 for GPU memory
    cpu_count = multiprocessing.cpu_count()
    model_server_workers = min(4, (2 * cpu_count) + 1)

    # Start gunicorn
    print(f"Starting gunicorn with {model_server_workers} workers...")
    gunicorn_command = [
        "gunicorn",
        "--timeout", "300",
        "--workers", str(model_server_workers),
        "--bind", "unix:/tmp/gunicorn.sock",
        "--worker-class", "gevent",
        "--log-level", "info",
        "--access-logfile", "-",
        "--error-logfile", "-",
        "wsgi:app"
    ]

    gunicorn_process = subprocess.Popen(gunicorn_command)

    # Start nginx
    print("Starting nginx...")
    nginx_command = ["nginx", "-c", "/opt/ml/code/nginx.conf"]
    nginx_process = subprocess.Popen(nginx_command)

    # Register signal handler
    signal.signal(
        signal.SIGTERM,
        lambda a, b: sigterm_handler(nginx_process.pid, gunicorn_process.pid)
    )

    print("Server started successfully!")
    print(f"Nginx PID: {nginx_process.pid}")
    print(f"Gunicorn PID: {gunicorn_process.pid}")

    # Wait for processes
    pids = {nginx_process.pid, gunicorn_process.pid}
    while True:
        pid, _ = os.wait()
        if pid in pids:
            break

    sigterm_handler(nginx_process.pid, gunicorn_process.pid)
    print("Server stopped")


if __name__ == "__main__":
    start_server()
